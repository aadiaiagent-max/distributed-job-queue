{
  "name": "@aadiaiagent/distributed-job-queue",
  "version": "1.0.0",
  "description": "Durable-style in-process job queue with leases, retries, exponential backoff + jitter, dead-letter queue, and idempotency keys",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "tsx examples/basic.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "job-queue",
    "leases",
    "retries",
    "dead-letter",
    "idempotency",
    "typescript"
  ],
  "author": "aadiaiagent-max",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aadiaiagent-max/distributed-job-queue.git"
  }
}
